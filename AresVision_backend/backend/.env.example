# AI 服务配置
# 请在此处填写你的 Google Gemini API Key 或其他兼容的 API Key
AI_API_KEY="your-api-key-here"

# 认证配置
# 生产环境下请修改此密钥以确保系统安全
JWT_SECRET_KEY=aresvision-jwt-secret-change-in-production
DEFAULT_ADMIN_EMAIL=admin@aresvision.com
DEFAULT_ADMIN_PASSWORD=admin123

# 邮件服务配置 (可选，用于发送系统通知)
SMTP_HOST="smtp.qq.com"
SMTP_PORT=465
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_NAME="AresVision 智绘赤星"

# 训练环境配置
# 指定训练脚本执行时使用的 Python 解释器路径 (建议使用 Conda 虚拟环境)
TRAINING_PYTHON_PATH="C:\Path\To\Your\Environment\python.exe"
